<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action: Abre el editor de carteles como vista OWL -->
    <record id="action_cartel_editor" model="ir.actions.client">
        <field name="name">Constructor de Carteles</field>
        <field name="tag">cc_cartel_editor</field>
        <field name="target">current</field>
    </record>

    <!--
        NOTA: La acción "Mis Diseños" (galería) apunta a una vista de lista
        estándar del modelo cc.cartel.design usando ir.actions.act_window.
        No requiere componente OWL adicional — usa la UI de Odoo nativa.
    -->
    <record id="action_cartel_gallery" model="ir.actions.act_window">
        <field name="name">Mis Diseños Guardados</field>
        <field name="res_model">cc.cartel.design</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
