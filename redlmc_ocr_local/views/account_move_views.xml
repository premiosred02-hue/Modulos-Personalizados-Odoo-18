<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_redlmc_ocr_local" model="ir.ui.view">
        <field name="name">account.move.form.redlmc.ocr.local</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botón Extraer sin IA (fusionado en redlmc_ai_assistant) -->
            
            <xpath expr="//page[@name='ai_analysis_tab']" position="inside">
                <group string="Texto extraído localmente">
                    <field name="ocr_local_text" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
